{
  "name": "shift",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "tsx scripts/validate.ts",
    "gen": "esbuild scripts/gen.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen.mjs --log-level=warning && node node_modules/.cache/gen.mjs",
    "check": "tsc --noEmit && vitest run && tsx scripts/validate.ts",
    "models": "tsx scripts/build-models.ts",
    "cover": "tsx scripts/cover.ts"
  },
  "description": "SHIFT: Between Two Worlds - a two-dimension stealth exploration game with a level editor",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "private": true,
  "type": "module"
}
